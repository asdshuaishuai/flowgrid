{
    "fileName": "flowgrid-deepin",
    "name": "FlowGrid 设置",
    "comment": "FlowGrid 键鼠共享（deepin 客户端）配置",
    "org.deepin.dde.interface": "flowgrid",
    "id": "io.github.asdshuaishuai.flowgrid",
    "keys": [
        { "key": "connection/preferred_link", "type": "s", "default": "IntelligentLink",
          "name": "优先链路", "description": "IntelligentLink / DirectLink / IntelligentLinkOnly" },
        { "key": "connection/auto_routing", "type": "b", "default": true,
          "name": "自动路由", "description": "按延迟自动选择中转节点" },
        { "key": "connection/auto_start", "type": "b", "default": true,
          "name": "开机自启", "description": "登录后托盘常驻" },

        { "key": "input/keymap_enabled", "type": "b", "default": true,
          "name": "键位映射", "description": "跨平台修饰键转换" },
        { "key": "input/mouse_smoothing", "type": "b", "default": false,
          "name": "鼠标平滑", "description": "降低跨屏移动抖动" },
        { "key": "input/edge_threshold", "type": "i", "default": 8,
          "name": "边缘切换阈值", "description": "指针抵达屏幕边缘后触发的像素数" },
        { "key": "input/switch_hotkey", "type": "i", "default": 1,
          "name": "切换热键", "description": "按住后按数字键直切（1=Ctrl，2=Alt）" },

        { "key": "sync/clipboard_enabled", "type": "b", "default": true,
          "name": "剪贴板同步", "description": "文本与图片，单条上限 8 MB" },
        { "key": "sync/clipboard_history", "type": "i", "default": 50,
          "name": "历史条数", "description": "超出后按时间淘汰" },
        { "key": "sync/file_transfer_enabled", "type": "b", "default": true,
          "name": "文件传输", "description": "拖放或选择文件发送" },

        { "key": "security/e2e_encryption", "type": "b", "default": true,
          "name": "端到端加密", "description": "XChaCha20-Poly1305，强制开启不可关闭" },
        { "key": "security/require_confirmation", "type": "b", "default": true,
          "name": "新设备需确认", "description": "关闭后任何局域网设备可直接配对" }
    ]
}
