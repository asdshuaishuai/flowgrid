<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      L2 语义色 · Light（design/unified/tokens.css §2）
      + L3 Windows 强调色（#0878d8，浅色档）。组件一律 DynamicResource 消费。
    -->
    <SolidColorBrush x:Key="BrushCanvas" Color="#EAEDF2"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSurface2" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="BrushSurface3" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="BrushSurfaceHi" Color="#0A101828"/>
    <SolidColorBrush x:Key="BrushSurfacePress" Color="#13101828"/>

    <SolidColorBrush x:Key="BrushLine1" Color="#12101828"/>
    <SolidColorBrush x:Key="BrushLine2" Color="#1F101828"/>
    <SolidColorBrush x:Key="BrushLine3" Color="#38101828"/>
    <SolidColorBrush x:Key="BrushHairline" Color="#0E101828"/>
    <SolidColorBrush x:Key="BrushEdgeHi" Color="#BFFFFFFF"/>

    <SolidColorBrush x:Key="BrushText1" Color="#171B21"/>
    <SolidColorBrush x:Key="BrushText2" Color="#5F6875"/>
    <SolidColorBrush x:Key="BrushText3" Color="#8B93A0"/>

    <SolidColorBrush x:Key="BrushOkSolid" Color="#10A36F"/>
    <SolidColorBrush x:Key="BrushOkText" Color="#0A7D55"/>
    <SolidColorBrush x:Key="BrushOkSoft" Color="#1F10A36F"/>
    <SolidColorBrush x:Key="BrushOkLine" Color="#4710A36F"/>

    <SolidColorBrush x:Key="BrushWarnSolid" Color="#D97706"/>
