    <SolidColorBrush x:Key="BrushOverlay" Color="#26000000"/>
    <SolidColorBrush x:Key="BrushToastBg" Color="#F01C222C"/>
    <SolidColorBrush x:Key="BrushToastFg" Color="#FFFFFF"/>
</ResourceDictionary>
