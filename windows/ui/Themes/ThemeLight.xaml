    <SolidColorBrush x:Key="BrushWarnSoft" Color="#1FD97706"/>
    <SolidColorBrush x:Key="BrushWarnLine" Color="#4DD97706"/>

    <SolidColorBrush x:Key="BrushDangerSolid" Color="#DC2626"/>
