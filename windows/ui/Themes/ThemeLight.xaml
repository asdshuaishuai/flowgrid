    <SolidColorBrush x:Key="BrushDangerSoft" Color="#1CDC2626"/>
    <SolidColorBrush x:Key="BrushDangerLine" Color="#47DC2626"/>

    <SolidColorBrush x:Key="BrushIdleSolid" Color="#8A93A1"/>
    <SolidColorBrush x:Key="BrushIdleText" Color="#6B7480"/>
    <SolidColorBrush x:Key="BrushIdleSoft" Color="#218A93A1"/>
    <SolidColorBrush x:Key="BrushIdleLine" Color="#428A93A1"/>

    <SolidColorBrush x:Key="BrushAccent" Color="#0878D8"/>
