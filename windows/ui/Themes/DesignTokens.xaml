<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      设计令牌 · 形态层（主题无关）。
      逐条移植 design/unified/tokens.css v2 §0–§5；与 deepin designtokens.h 同源。
      颜色不在此文件——颜色在 ThemeLight/ThemeDark.xaml（L2 语义层）。
      组件一律 DynamicResource 消费，不得自造数值。
    -->

    <!-- §0 窗口几何 -->
    <sys:Double x:Key="WPanel">520</sys:Double>
    <sys:Double x:Key="WTray">300</sys:Double>
    <sys:Double x:Key="HTitlebar">34</sys:Double>
    <Thickness x:Key="PadContent">14</Thickness>
    <sys:Double x:Key="HControl">28</sys:Double>
    <sys:Double x:Key="HIconBtn">26</sys:Double>
    <sys:Double x:Key="WSwitch">36</sys:Double>
    <sys:Double x:Key="HSwitch">20</sys:Double>
    <sys:Double x:Key="HSwitchKnob">16</sys:Double>

    <!-- 壳层适配：左侧导航轨宽度（设计稿未定义壳层，见 windows-ui-shell design.md D2） -->
    <sys:Double x:Key="WNavRail">44</sys:Double>
    <!-- GridLength 变体：RowDefinition/ColumnDefinition 不接受 Double 令牌 -->
    <GridLength x:Key="RowTitlebar">34</GridLength>
    <GridLength x:Key="ColNavRail">44</GridLength>
    <sys:Double x:Key="RowTitlebarNum">34</sys:Double>

    <!-- §2 间距：统一 4 的倍数 -->
    <sys:Double x:Key="S1">4</sys:Double>
    <sys:Double x:Key="S2">8</sys:Double>
    <sys:Double x:Key="S3">12</sys:Double>
    <sys:Double x:Key="S4">16</sys:Double>
    <sys:Double x:Key="S5">20</sys:Double>
    <sys:Double x:Key="S6">24</sys:Double>
    <Thickness x:Key="PadV2">0,2,0,0</Thickness>

    <!-- §3 圆角：4 级 + pill（pill = 高度一半，由使用处按高求值） -->
    <CornerRadius x:Key="RadiusChip">4</CornerRadius>
    <CornerRadius x:Key="RadiusCtl">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusSurface">12</CornerRadius>

    <!-- §4 排版阶梯 -->
    <sys:Double x:Key="Font11">11</sys:Double>
    <sys:Double x:Key="Font12">12</sys:Double>
    <sys:Double x:Key="Font13">13</sys:Double>
    <sys:Double x:Key="Font15">15</sys:Double>
    <sys:Double x:Key="Font20">20</sys:Double>
    <sys:Double x:Key="Font28">28</sys:Double>

    <!-- §3 Windows 字体栈（tokens.css [data-plat="windows"]；字体族与形态常量同放此处，颜色仍在 Theme*） -->
    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Noto Sans SC</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>

    <!-- §5 组件尺寸 -->
    <sys:Double x:Key="BadgeHeight">18</sys:Double>
    <sys:Double x:Key="StatusPillHeight">20</sys:Double>
    <sys:Double x:Key="StatusDotSize">7</sys:Double>
    <sys:Double x:Key="DeviceIconSize">42</sys:Double>
    <sys:Double x:Key="ChartHeight">70</sys:Double>
    <sys:Double x:Key="EmptyIconSize">40</sys:Double>
    <sys:Double x:Key="PairSlotW">34</sys:Double>
    <sys:Double x:Key="PairSlotH">42</sys:Double>
    <sys:Double x:Key="LatChipMinWidth">56</sys:Double>
    <Thickness x:Key="PadPill">8,0,8,0</Thickness>
    <Thickness x:Key="PadBadge">7,0,7,0</Thickness>
    <Thickness x:Key="PadBtnH">12,0,12,0</Thickness>
    <Thickness x:Key="PadBtnSmH">8,0,8,0</Thickness>

    <!-- 复合边距（值全部取自 S 阶梯，供 Margin 单值位使用） -->
    <Thickness x:Key="PadL6">6,0,0,0</Thickness>
    <Thickness x:Key="PadL12">12,0,0,0</Thickness>
    <Thickness x:Key="PadAll12">12</Thickness>
    <Thickness x:Key="PadT12">0,12,0,0</Thickness>
    <Thickness x:Key="PadT16">0,16,0,0</Thickness>
    <Thickness x:Key="PadB12">0,0,0,12</Thickness>
</ResourceDictionary>
