<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      控件样式：只消费令牌资源（DesignTokens + Theme*），不得出现字面量颜色/尺寸。
      形态 1:1 对齐 design/unified/ui.css 的同名 class（.btn/.badge/.dot/.status-pill/
      .device/.lat/.section/.key/.chart/.preview/.bar/.xfer/.drop/.list/.banner/.empty/
      .steps/.paircode/.toast/.switch/.seg/.input/.tray__item/.switch-btn）。
    -->

    <!-- ── 文本 ─────────────────────────────────────────────────────────── -->
    <Style x:Key="TextMain" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font13}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushText1}"/>
    </Style>
    <Style x:Key="TextSecondary" TargetType="TextBlock" BasedOn="{StaticResource TextMain}">
        <Setter Property="FontSize" Value="{StaticResource Font12}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushText2}"/>
    </Style>
    <Style x:Key="TextMuted" TargetType="TextBlock" BasedOn="{StaticResource TextMain}">
        <Setter Property="FontSize" Value="{StaticResource Font12}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushText3}"/>
    </Style>
    <Style x:Key="TextCaption" TargetType="TextBlock" BasedOn="{StaticResource TextMain}">
        <Setter Property="FontSize" Value="{StaticResource Font11}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushText3}"/>
    </Style>
    <Style x:Key="TextTitle" TargetType="TextBlock" BasedOn="{StaticResource TextMain}">
        <Setter Property="FontSize" Value="{StaticResource Font15}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="TextMono" TargetType="TextBlock" BasedOn="{StaticResource TextMain}">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
    </Style>

    <!-- ── 按钮（.btn 及变体；hover 150ms 颜色渐变 via overlay border） ──── -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource HControl}"/>
        <Setter Property="Padding" Value="{StaticResource PadBtnH}"/>
        <Setter Property="FontSize" Value="{StaticResource Font12}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="{StaticResource RadiusCtl}"
                                Background="{DynamicResource BrushAccent}"/>
                        <Border x:Name="HoverOv" CornerRadius="{StaticResource RadiusCtl}"
                                Background="{DynamicResource BrushAccentHover}" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOv"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOv"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverOv" Property="Background" Value="{DynamicResource BrushAccentPress}"/>
                            <Setter TargetName="HoverOv" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="{StaticResource RadiusCtl}"
                                Background="{DynamicResource BrushSurface}"
                                BorderThickness="1" BorderBrush="{DynamicResource BrushLine2}"/>
                        <Border x:Name="HoverOv" CornerRadius="{StaticResource RadiusCtl}"
                                Background="{DynamicResource BrushSurfaceHi}" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{DynamicResource BrushText1}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOv"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOv"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverOv" Property="Background" Value="{DynamicResource BrushSurfacePress}"/>
                            <Setter TargetName="HoverOv" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="{StaticResource RadiusCtl}"
                            Background="{DynamicResource BrushDangerSolid}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{DynamicResource BrushOnAccent}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .btn-sm：24 高、8 内边、11 号（类名 btn sm 变体） -->
    <Style x:Key="BtnSmSecondary" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="{StaticResource PadBtnSmH}"/>
        <Setter Property="FontSize" Value="{StaticResource Font11}"/>
    </Style>

    <!-- .icon-btn：26×26 幽灵钮 -->
    <Style x:Key="BtnGhost" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource HIconBtn}"/>
        <Setter Property="Height" Value="{StaticResource HIconBtn}"/>
        <Setter Property="FontSize" Value="{StaticResource Font11}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushText3}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="{StaticResource RadiusCtl}" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSurfaceHi}"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushText1}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSurfacePress}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 状态 pill 与状态点（.status-pill / .dot-pulse 2s） ───────────── -->
    <Style x:Key="PillBorder" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource StatusPillHeight}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="{StaticResource PadPill}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="PillOk" TargetType="Border" BasedOn="{StaticResource PillBorder}">
        <Setter Property="Background" Value="{DynamicResource BrushOkSoft}"/>
    </Style>
    <Style x:Key="PillWarn" TargetType="Border" BasedOn="{StaticResource PillBorder}">
        <Setter Property="Background" Value="{DynamicResource BrushWarnSoft}"/>
    </Style>
    <Style x:Key="PillDanger" TargetType="Border" BasedOn="{StaticResource PillBorder}">
        <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
    </Style>
    <Style x:Key="PillIdle" TargetType="Border" BasedOn="{StaticResource PillBorder}">
        <Setter Property="Background" Value="{DynamicResource BrushIdleSoft}"/>
    </Style>

    <!-- .dot-pulse：2s 无限呼吸 -->
    <Style x:Key="DotPulse" TargetType="Ellipse">
        <Setter Property="Width" Value="{StaticResource StatusDotSize}"/>
        <Setter Property="Height" Value="{StaticResource StatusDotSize}"/>
        <Setter Property="Fill" Value="{DynamicResource BrushOkSolid}"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Ellipse.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1" To="0.4" Duration="0:0:1"
                                         AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── 徽章（.badge 默认 accent 系 + 变体） ─────────────────────────── -->
    <Style x:Key="BadgeBorder" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource BadgeHeight}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="{StaticResource PadBadge}"/>
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
    </Style>
    <Style x:Key="BadgeNeutral" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
        <Setter Property="Background" Value="{DynamicResource BrushSurface3}"/>
    </Style>
    <Style x:Key="BadgeOk" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
        <Setter Property="Background" Value="{DynamicResource BrushOkSoft}"/>
    </Style>
    <Style x:Key="BadgeWarn" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
        <Setter Property="Background" Value="{DynamicResource BrushWarnSoft}"/>
    </Style>
    <Style x:Key="BadgeDanger" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
        <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
    </Style>

    <!-- ── 设备卡（.device：border line-2 + hover line-3/lift） ─────────── -->
    <Style x:Key="DeviceCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLine2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource PadAll12}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushLine3}"/>
                <!-- ui.css .device:hover 的 shadow-lift；阴影色主题无关，取石墨基色 -->
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270"
                                          Opacity="0.18" Color="#101828"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 延迟芯片（.lat：56 最小宽 / 12 bold，三档语义） ──────────────── -->
    <Style x:Key="LatChip" TargetType="Border">
        <Setter Property="MinWidth" Value="{StaticResource LatChipMinWidth}"/>
        <Setter Property="Padding" Value="8,4,8,4"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="LatGood" TargetType="Border" BasedOn="{StaticResource LatChip}">
        <Setter Property="Background" Value="{DynamicResource BrushOkSoft}"/>
    </Style>
    <Style x:Key="LatWarn" TargetType="Border" BasedOn="{StaticResource LatChip}">
        <Setter Property="Background" Value="{DynamicResource BrushWarnSoft}"/>
    </Style>
    <Style x:Key="LatBad" TargetType="Border" BasedOn="{StaticResource LatChip}">
        <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
    </Style>
    <Style x:Key="LatIdle" TargetType="Border" BasedOn="{StaticResource LatChip}">
        <Setter Property="Background" Value="{DynamicResource BrushIdleSoft}"/>
    </Style>

    <!-- ── 折叠区（.section 卡片 + chevron rotate 200ms） ───────────────── -->
    <Style x:Key="SectionExpander" TargetType="Expander">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border CornerRadius="{StaticResource RadiusCard}"
                            Background="{DynamicResource BrushSurface2}"
                            BorderBrush="{DynamicResource BrushLine2}"
                            BorderThickness="1">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Head" Background="Transparent" Padding="9,9,12,9">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Head" Property="Background" Value="{DynamicResource BrushSurfaceHi}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed"
                                              Content="{TemplateBinding Content}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- chevron：展开朝下、收起 -90°，随所在 Expander 状态 200ms 联动（ui.css .section .chevron） -->
    <Style x:Key="Chevron" TargetType="TextBlock">
        <Setter Property="Text" Value="▾"/>
        <Setter Property="FontSize" Value="{StaticResource Font11}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushText3}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="-90"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                             To="0" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                             To="-90" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── 开关（.switch：36×20 药丸 + 16 白钮 200ms 滑动，开=ok-solid） ── -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource WSwitch}"/>
        <Setter Property="Height" Value="{StaticResource HSwitch}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="10"
                                Background="{DynamicResource BrushSurface3}"/>
                        <Ellipse x:Name="Knob" Width="{StaticResource HSwitchKnob}"
                                 Height="{StaticResource HSwitchKnob}" Fill="#FFFFFF"
                                 HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrushOkSolid}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="16" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 分段过滤（.seg 容器 + .seg button） ───────────────────────────── -->
    <Style x:Key="SegContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushSurface3}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCtl}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SegItem" TargetType="RadioButton">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="10,0,10,0"/>
        <Setter Property="FontSize" Value="{StaticResource Font11}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Text" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource BrushText2}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource BrushText1}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSurface}"/>
                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource BrushText1}"/>
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.18"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 输入框（.input：28 高，focus accent 边 + 3px soft 环） ────────── -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource HControl}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource Font12}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushText1}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushText1}"/>
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="9" BorderThickness="3"
                                BorderBrush="Transparent"/>
                        <Border x:Name="Bd" CornerRadius="{StaticResource RadiusCtl}"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="{DynamicResource BrushLine2}"
                                Margin="3,3,3,3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0,8,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource BrushAccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 键帽（.key：34 最小宽 + mono 11 + 底部 1px 投影） ─────────────── -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Padding" Value="7,5,7,5"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCtl}"/>
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLine2}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ── 列表卡（.list + .list__row + 分组标题） ───────────────────────── -->
    <Style x:Key="ListCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLine2}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ListGroupTitle" TargetType="Border">
        <Setter Property="Padding" Value="12,8,12,6"/>
        <Setter Property="Background" Value="{DynamicResource BrushSurface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHairline}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="ListRow" TargetType="Border">
        <Setter Property="Padding" Value="12,10,12,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHairline}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushSurfaceHi}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 提示条（.banner 四档） ────────────────────────────────────────── -->
    <Style x:Key="BannerAccent" TargetType="Border">
        <Setter Property="Padding" Value="12,10,12,10"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="BannerWarn" TargetType="Border" BasedOn="{StaticResource BannerAccent}">
        <Setter Property="Background" Value="{DynamicResource BrushWarnSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushWarnLine}"/>
    </Style>
    <Style x:Key="BannerNeutral" TargetType="Border" BasedOn="{StaticResource BannerAccent}">
        <Setter Property="Background" Value="{DynamicResource BrushSurface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLine2}"/>
    </Style>

    <!-- ── 预览卡（.preview 三段：head/body/foot） ───────────────────────── -->
    <Style x:Key="PreviewCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Background" Value="{DynamicResource BrushSurface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLine1}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="PreviewHeadFoot" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
        <Setter Property="Padding" Value="12,7,12,7"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHairline}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <!-- ── 进度条（.bar 5px 药丸；100% 时转 ok 色，对齐 ui.css bar fill ok 态） ── -->
    <Style x:Key="ProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
        <Setter Property="Background" Value="{DynamicResource BrushSurface3}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2.5"
                                Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}" Value="100">
                            <Setter TargetName="PART_Indicator" Property="Background" Value="{DynamicResource BrushOkSolid}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 拖放区（.drop：虚线 2px + hover accent） ──────────────────────── -->
    <Style x:Key="DropZone" TargetType="Border">
        <Setter Property="Padding" Value="12,20,12,20"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Background" Value="{DynamicResource BrushSurface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLine2}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 空状态（.empty） ──────────────────────────────────────────────── -->
    <Style x:Key="EmptyIcon" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource EmptyIconSize}"/>
        <Setter Property="Height" Value="{StaticResource EmptyIconSize}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="{DynamicResource BrushSurface3}"/>
    </Style>

    <!-- ── 导航轨条目（壳层适配） ────────────────────────────────────────── -->
    <Style x:Key="NavRailItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Margin="4,2" CornerRadius="{StaticResource RadiusCtl}"
                            Background="Transparent">
                        <ContentPresenter x:Name="Text" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontSize="{StaticResource Font11}"
                                          TextElement.Foreground="{DynamicResource BrushText2}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSurfaceHi}"/>
                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource BrushText1}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource BrushAccentText}"/>
                            <Setter TargetName="Text" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 标题栏关闭钮（.wctl-flat-close） ────────────────────────────── -->
    <Style x:Key="TitlebarClose" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="{StaticResource HTitlebar}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushText2}"/>
        <Setter Property="FontSize" Value="{StaticResource Font12}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 托盘浮板条目（.tray__item / / danger 变体 / .tray__toggle） ────────── -->
    <Style x:Key="TrayItem" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource Font12}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushText1}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Padding="12,7,12,7"/>
                        <Border x:Name="HoverOv" Background="{DynamicResource BrushSurfaceHi}"
                                Opacity="0" Padding="12,7,12,7"/>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOv"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOv"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrayItemDanger" TargetType="Button" BasedOn="{StaticResource TrayItem}">
        <Setter Property="Foreground" Value="{DynamicResource BrushDangerText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" Padding="12,7,12,7">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{DynamicResource BrushDangerText}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 细滚动条（tokens §5 10px） ────────────────────────────────────── -->
    <Style x:Key="SlimScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="4" Margin="1" Background="{DynamicResource BrushLine3}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource SlimScrollBarThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
