<UserControl x:Class="FlowGrid.UI.Views.PairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowGrid.UI.Views">
    <!-- pairing.html：.steps 三态（done/on/pending）+ accent banner + 4 位配对码 + 发现设备 + 手动添加 -->
    <DockPanel Margin="{StaticResource PadContent}">

        <!-- 页脚：左取消 / 右步骤进度 -->
        <Grid DockPanel.Dock="Bottom" Margin="{StaticResource PadT12}">
            <Button Style="{StaticResource BtnSmSecondary}" Content="取消" HorizontalAlignment="Left"
                    Click="OnCancelClick"/>
            <TextBlock Text="第 2 步 · 共 3 步" Style="{StaticResource TextCaption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="添加设备" Style="{StaticResource TextTitle}" Margin="{StaticResource PadB12}"/>

                <!-- 步骤条：编号与文字同行；done=ok-soft ✓ / on=accent 实底 / pending=灰 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource PadB12}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10"
                                Background="{DynamicResource BrushOkSoft}"
                                BorderBrush="{DynamicResource BrushOkLine}" BorderThickness="1">
                            <views:Icon Data="{StaticResource IconCheck}" Size="10"
                                        TextElement.Foreground="{DynamicResource BrushOkText}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="发现" FontSize="{StaticResource Font11}"
                                   Foreground="{DynamicResource BrushText3}"
                                   VerticalAlignment="Center" Margin="{StaticResource PadL6}"/>
                    </StackPanel>
                    <Border Width="20" Height="1" Background="{DynamicResource BrushLine2}"
                            VerticalAlignment="Center" Margin="10,0,10,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10"
                                Background="{DynamicResource BrushAccent}">
                            <TextBlock Text="2" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushOnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="配对" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushText1}"
                                   VerticalAlignment="Center" Margin="{StaticResource PadL6}"/>
                    </StackPanel>
                    <Border Width="20" Height="1" Background="{DynamicResource BrushLine2}"
                            VerticalAlignment="Center" Margin="10,0,10,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10"
                                Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushLine2}" BorderThickness="1">
                            <TextBlock Text="3" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushText3}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="完成" FontSize="{StaticResource Font11}"
                                   Foreground="{DynamicResource BrushText3}"
                                   VerticalAlignment="Center" Margin="{StaticResource PadL6}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 说明 banner -->
                <Border Style="{StaticResource BannerAccent}" Margin="{StaticResource PadB12}">
                    <StackPanel Orientation="Horizontal">
                        <views:Icon Data="{StaticResource IconInfo}" Size="14"
                                    TextElement.Foreground="{DynamicResource BrushAccentText}"
                                    VerticalAlignment="Center"/>
                        <TextBlock Text="在新设备上打开 FlowGrid → 添加设备，输入下面的一次性配对码。"
                                   FontSize="{StaticResource Font12}"
                                   Foreground="{DynamicResource BrushAccentText}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="{StaticResource PadL6}"/>
                    </StackPanel>
                </Border>

                <!-- 一次性配对码（4 位；生成随连接里程碑，D4） -->
                <TextBlock Text="一次性配对码" Style="{StaticResource TextCaption}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="{StaticResource PadB12}"/>
                <Grid HorizontalAlignment="Center" Margin="{StaticResource PadB12}">
                    <Rectangle Stroke="{DynamicResource BrushLine2}" StrokeThickness="1"
                               StrokeDashArray="4 4" RadiusX="10" RadiusY="10"
                               Fill="{DynamicResource BrushSurface2}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="12">
                        <Border Width="{StaticResource PairSlotW}" Height="{StaticResource PairSlotH}"
                                CornerRadius="{StaticResource RadiusCtl}" Background="{DynamicResource BrushSurface}"
                                Margin="0,0,8,0">
                            <TextBlock Text="·" Style="{StaticResource TextMono}" FontSize="{StaticResource Font20}"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="{StaticResource PairSlotW}" Height="{StaticResource PairSlotH}"
                                CornerRadius="{StaticResource RadiusCtl}" Background="{DynamicResource BrushSurface}"
                                Margin="0,0,8,0">
                            <TextBlock Text="·" Style="{StaticResource TextMono}" FontSize="{StaticResource Font20}"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="{StaticResource PairSlotW}" Height="{StaticResource PairSlotH}"
                                CornerRadius="{StaticResource RadiusCtl}" Background="{DynamicResource BrushSurface}"
                                Margin="0,0,8,0">
                            <TextBlock Text="·" Style="{StaticResource TextMono}" FontSize="{StaticResource Font20}"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="{StaticResource PairSlotW}" Height="{StaticResource PairSlotH}"
                                CornerRadius="{StaticResource RadiusCtl}" Background="{DynamicResource BrushSurface}">
                            <TextBlock Text="·" Style="{StaticResource TextMono}" FontSize="{StaticResource Font20}"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
                <Grid Margin="{StaticResource PadB12}" IsEnabled="False">
                    <TextBlock Text="配对码由 fgcore 在连接里程碑生成 · 5 分钟后失效"
                               Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BtnGhost}" Opacity="0.5" ToolTip="待后续里程碑"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <views:Icon Data="{StaticResource IconRefresh}" Size="12"
                                    TextElement.Foreground="{DynamicResource BrushText3}"/>
                    </Button>
                </Grid>

                <!-- 网络中的设备（fgcore devices.list 实时数据） -->
                <Border Style="{StaticResource ListCard}" Margin="{StaticResource PadB12}">
                    <StackPanel>
                        <Border Style="{StaticResource ListGroupTitle}">
                            <TextBlock Text="网络中的设备" Style="{StaticResource TextCaption}"/>
                        </Border>
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextMain}"/>
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource TextCaption}" Margin="{StaticResource PadV2}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource BtnSmSecondary}" Content="发起配对"
                                                    VerticalAlignment="Center"
                                                    Tag="{Binding Instance}" Click="OnPairClick"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoDevices" Text="暂未发现设备；确认对端已启动 FlowGrid 并在同一网段"
                                   Style="{StaticResource TextCaption}" Margin="12,10,12,10"/>
                    </StackPanel>
                </Border>

                <!-- 手动添加（后端无按地址直连 API，整组 D4） -->
                <Expander Style="{StaticResource SectionExpander}" IsExpanded="False">
                    <Expander.Header>
                        <Grid Height="{StaticResource HControl}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <views:Icon Data="{StaticResource IconLan}" Size="12"
                                            TextElement.Foreground="{DynamicResource BrushText3}"
                                            VerticalAlignment="Center"/>
                                <TextBlock Text="手动添加" FontSize="{StaticResource Font12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"
                                           Margin="{StaticResource PadL6}"/>
                                <Border Style="{StaticResource BadgeNeutral}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="高级" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText2}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Chevron}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="12" Opacity="0.5" IsEnabled="False">
                        <TextBlock Text="设备地址" Style="{StaticResource TextCaption}" Margin="{StaticResource PadB12}"/>
                        <TextBox Style="{StaticResource Input}"/>
                        <TextBlock Text="备注名" Style="{StaticResource TextCaption}" Margin="{StaticResource PadT12}"/>
                        <TextBox Style="{StaticResource Input}"/>
                        <Button Style="{StaticResource BtnSmSecondary}" Content="连接" HorizontalAlignment="Left"
                                Margin="{StaticResource PadT12}" ToolTip="待后续里程碑"/>
                        <TextBlock Text="待后续里程碑（当前通过网络发现配对）" Style="{StaticResource TextCaption}"
                                   Margin="{StaticResource PadT12}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
