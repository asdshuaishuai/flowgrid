<UserControl x:Class="FlowGrid.UI.Views.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowGrid.UI.Views">
    <!-- clipboard.html：预览卡 + 过滤搜索 + 历史 + 同步设置 + 页脚 -->
    <DockPanel Margin="{StaticResource PadContent}">
        <!-- 过滤 + 搜索 -->
        <Grid DockPanel.Dock="Top" Margin="{StaticResource PadT12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="FilterAll" GroupName="clipkind" Content="全部" IsChecked="True"
                             Checked="OnFilterChanged" Margin="0,0,12,0"/>
                <RadioButton GroupName="clipkind" Content="文本" Checked="OnFilterChanged" Margin="0,0,12,0"/>
                <RadioButton x:Name="FilterLink" GroupName="clipkind" Content="链接" Checked="OnFilterChanged"/>
            </StackPanel>
            <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource Input}" Width="150" Height="{StaticResource HControl}"
                     VerticalContentAlignment="Center" FontSize="{StaticResource Font12}"
                     TextChanged="OnFilterChanged"/>
        </Grid>

        <!-- 页脚：清空历史 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="{StaticResource PadT12}">
            <Button Style="{StaticResource BtnSecondary}" Content="清空历史" Click="OnClearClick"/>
        </StackPanel>

        <ScrollViewer>
            <StackPanel>
                <!-- 当前剪贴板预览卡（clipboard.html .preview） -->
                <Border Style="{StaticResource DeviceCard}">
                    <StackPanel Margin="{StaticResource PadL6}">
                        <Grid Height="22">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="当前剪贴板" FontWeight="SemiBold"
                                           FontSize="{StaticResource Font12}"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource BadgeBorder}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="text/plain" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText3}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="PreviewText" Style="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="44"
                                   Margin="{StaticResource PadV2}" Text="（空）"/>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource PadT12}">
                            <Button Style="{StaticResource BtnSecondary}" Content="写入本地"
                                    Click="OnPreviewWriteClick"/>
                            <Button Style="{StaticResource BtnPrimary}" Content="推送到在线设备"
                                    Margin="{StaticResource PadL6}" Click="OnPreviewPushClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 同步设置折叠区 -->
                <Expander Style="{StaticResource SectionExpander}" Margin="{StaticResource PadT12}">
                    <Expander.Header>
                        <Grid Height="{StaticResource HControl}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="同步设置" FontSize="{StaticResource Font12}" FontWeight="Medium"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource BadgeBorder}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="2 项" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText3}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="▸" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="{StaticResource PadAll12}">
                        <Grid Height="24">
                            <TextBlock Text="跨端同步" Style="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="SyncToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          Checked="OnSyncToggle" Unchecked="OnSyncToggle"/>
                        </Grid>
                        <Grid Height="24">
                            <TextBlock Text="接收后自动写入本地" Style="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <TextBlock Text="已启用" Style="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="{StaticResource PadT12}"
                                   Text="单条上限 63,240 B（协议 §5.3 分段上限），超出不同步；仅同步文本，图片/代码待后续里程碑。"/>
                    </StackPanel>
                </Expander>

                <TextBlock Text="同步历史 · 保留最近 50 条" Style="{StaticResource TextCaption}" Margin="{StaticResource PadT16}"/>
                <ItemsControl x:Name="History">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeviceCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Preview}" FontSize="{StaticResource Font12}"
                                                   Foreground="{DynamicResource BrushText1}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Hint}" FontSize="{StaticResource Font11}"
                                                   Foreground="{DynamicResource BrushText3}" Margin="{StaticResource PadV2}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Time}" FontSize="{StaticResource Font11}"
                                                   Foreground="{DynamicResource BrushText3}" VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource BtnGhost}" Content="写入"
                                                Tag="{Binding Index}" Click="OnWriteClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:EmptyState x:Name="NoHistory" Title="暂无剪贴板记录"
                                  Description="本机复制或对端同步的文本会出现在这里"
                                  Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
