<UserControl x:Class="FlowGrid.UI.Views.LatencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowGrid.UI.Views">
    <!-- latency.html：大号当前延迟 + .chart 12 柱 + 分设备列表 -->
    <DockPanel Margin="{StaticResource PadContent}">
        <TextBlock DockPanel.Dock="Top" Text="网络延迟"
                   Style="{StaticResource TextTitle}" Margin="{StaticResource PadB12}"/>

        <!-- 当前延迟大号数字（.t-28.w-bold.mono） -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="当前延迟" Style="{StaticResource TextCaption}"/>
                <TextBlock x:Name="BigLatency" Text="—" FontSize="{StaticResource Font28}"
                           FontWeight="Bold" FontFamily="Consolas, Cascadia Mono"
                           Foreground="{DynamicResource BrushOkText}"/>
            </StackPanel>
        </Grid>

        <!-- .chart 12 柱延迟图 -->
        <Expander DockPanel.Dock="Top" Style="{StaticResource SectionExpander}" IsExpanded="True"
                  Margin="0,0,0,12">
            <Expander.Header>
                <Grid Height="{StaticResource HControl}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="近 60 秒采样" FontSize="{StaticResource Font12}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource BadgeOk}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                            <TextBlock x:Name="ChartBadge" Text="均值 —" FontSize="{StaticResource Font11}"
                                       Foreground="{DynamicResource BrushOkText}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="▾" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Expander.Header>
            <StackPanel>
                <views:LatencyChart x:Name="Chart" Margin="12,8,12,0"/>
                <Grid Margin="12,4,12,12">
                    <TextBlock Text="-60s" FontSize="{StaticResource Font11}"
                               Foreground="{DynamicResource BrushText3}"/>
                    <TextBlock Text="现在" FontSize="{StaticResource Font11}"
                               Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Expander>

        <!-- 分设备列表 -->
        <ListView x:Name="DeviceList" BorderThickness="0" Background="Transparent">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="设备" Width="150" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="平台" Width="100" DisplayMemberBinding="{Binding Platform}"/>
                    <GridViewColumn Header="当前" Width="80" DisplayMemberBinding="{Binding LatencyText}"/>
                    <GridViewColumn Header="min/均/max" Width="200" DisplayMemberBinding="{Binding LatencyStats}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
