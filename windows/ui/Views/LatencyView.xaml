<UserControl x:Class="FlowGrid.UI.Views.LatencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowGrid.UI.Views">
    <!-- latency.html：大号当前延迟 + 链路块 + .chart 12 柱 + 分设备列表 + 阈值折叠区 + 页脚 -->
    <DockPanel Margin="{StaticResource PadContent}">

        <!-- 页脚：左采样说明 / 右导出诊断（D4）+ 关闭 -->
        <Grid DockPanel.Dock="Bottom" Margin="{StaticResource PadT12}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <views:Icon Data="{StaticResource IconInfo}" Size="12"
                            TextElement.Foreground="{DynamicResource BrushText3}"
                            VerticalAlignment="Center"/>
                <TextBlock Text="每 2 秒采样一次" Style="{StaticResource TextCaption}"
                           Margin="{StaticResource PadL6}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnSmSecondary}" Content="导出诊断" IsEnabled="False"
                        ToolTip="待后续里程碑"/>
                <Button Style="{StaticResource BtnSmSecondary}" Content="关闭" Margin="{StaticResource PadL6}"
                        Click="OnCloseClick"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 读数行：当前延迟大数字 + 链路 -->
                <Grid Margin="{StaticResource PadB12}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前延迟" Style="{StaticResource TextCaption}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BigLatency" Text="—" FontSize="{StaticResource Font28}"
                                   FontWeight="Bold" FontFamily="{StaticResource FontMono}"
                                   Foreground="{DynamicResource BrushIdleText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="链路" Style="{StaticResource TextCaption}" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource PadV2}">
                            <views:Icon Data="{StaticResource IconWifi}" Size="12"
                                        TextElement.Foreground="{DynamicResource BrushText2}"
                                        VerticalAlignment="Center"/>
                            <TextBlock x:Name="LinkName" Text="DirectLink" Style="{StaticResource TextSecondary}"
                                       FontWeight="SemiBold" Margin="{StaticResource PadL6}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- .chart 12 柱延迟图 -->
                <Expander Style="{StaticResource SectionExpander}" IsExpanded="True"
                          Margin="{StaticResource PadB12}">
                    <Expander.Header>
                        <Grid Height="{StaticResource HControl}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <views:Icon Data="{StaticResource IconActivity}" Size="12"
                                            TextElement.Foreground="{DynamicResource BrushText3}"
                                            VerticalAlignment="Center"/>
                                <TextBlock Text="近 60 秒采样" FontSize="{StaticResource Font12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"
                                           Margin="{StaticResource PadL6}"/>
                                <Border Style="{StaticResource BadgeOk}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock x:Name="ChartBadge" Text="均值 —" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushOkText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Chevron}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <views:LatencyChart x:Name="Chart" Margin="12,8,12,0"/>
                        <Grid Margin="12,4,12,12">
                            <TextBlock Text="-60s" FontSize="{StaticResource Font11}"
                                       Foreground="{DynamicResource BrushText3}"/>
                            <TextBlock Text="现在" FontSize="{StaticResource Font11}"
                                       Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 分设备列表：离线也显示（idle 行） -->
                <Border Style="{StaticResource ListCard}">
                    <StackPanel>
                        <Border Style="{StaticResource ListGroupTitle}">
                            <TextBlock Text="分设备" Style="{StaticResource TextCaption}"/>
                        </Border>
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextMain}"/>
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource TextCaption}" Margin="{StaticResource PadV2}"/>
                                            </StackPanel>
                                            <Border x:Name="Chip" Grid.Column="1" Style="{StaticResource LatChip}"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="ChipText" Text="{Binding Text}" FontSize="{StaticResource Font12}"
                                                           FontWeight="Bold" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tier}" Value="good">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource BrushOkSoft}"/>
                                            <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource BrushOkText}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tier}" Value="warn">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource BrushWarnSoft}"/>
                                            <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource BrushWarnText}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tier}" Value="bad">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
                                            <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource BrushDangerText}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tier}" Value="idle">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource BrushIdleSoft}"/>
                                            <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource BrushIdleText}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoLinks" Text="暂无设备链接（fgcore 未连接或未发现对端）"
                                   Style="{StaticResource TextCaption}" Margin="12,10,12,10"/>
                    </StackPanel>
                </Border>

                <!-- 告警阈值（后端无配置面，整组 D4） -->
                <Expander Style="{StaticResource SectionExpander}" IsExpanded="False" Margin="{StaticResource PadT12}">
                    <Expander.Header>
                        <Grid Height="{StaticResource HControl}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <views:Icon Data="{StaticResource IconSettings}" Size="12"
                                            TextElement.Foreground="{DynamicResource BrushText3}"
                                            VerticalAlignment="Center"/>
                                <TextBlock Text="告警阈值" FontSize="{StaticResource Font12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"
                                           Margin="{StaticResource PadL6}"/>
                                <Border Style="{StaticResource BadgeNeutral}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="20ms" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText2}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Chevron}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="12" Opacity="0.5" IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="告警阈值" Style="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Style="{StaticResource Input}" Width="64" Text="20"/>
                                <TextBlock Text="ms" Style="{StaticResource TextCaption}"
                                           Margin="{StaticResource PadL6}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="{StaticResource PadT12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="连续超阈值次数" Style="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Style="{StaticResource Input}" Width="64" Text="3"/>
                                <TextBlock Text="次" Style="{StaticResource TextCaption}"
                                           Margin="{StaticResource PadL6}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="{StaticResource PadT12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="超阈值时自动切换链路" Style="{StaticResource TextMain}"/>
                                <TextBlock Text="待后续里程碑" Style="{StaticResource TextCaption}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="True" IsEnabled="False"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
