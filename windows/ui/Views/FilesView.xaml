<UserControl x:Class="FlowGrid.UI.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowGrid.UI.Views">
    <!-- files.html：进行中列表 + .drop 拖放区 + 传输记录 + 接收设置 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="{StaticResource PadContent}">
        <StackPanel>

            <!-- 进行中（.xfer 行：图标 + 名称/百分比 + .bar + meta） -->
            <TextBlock Text="进行中" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
            <ItemsControl x:Name="Transfers" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DeviceCard}" Margin="0,0,0,4" Padding="12,9,12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusCtl}"
                                        Background="{DynamicResource BrushSurface3}">
                                    <!-- 方向图标：send=upload / receive=download（FL7） -->
                                    <views:IconGlyph Size="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <views:IconGlyph.Style>
                                            <Style TargetType="views:IconGlyph">
                                                <Setter Property="Data" Value="{StaticResource IconUpload}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushText2}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReceive}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconDownload}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </views:IconGlyph.Style>
                                    </views:IconGlyph>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="{StaticResource PadL12}" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{StaticResource Font12}"
                                                   Foreground="{DynamicResource BrushText1}" TextTrimming="CharacterEllipsis"/>
                                        <!-- 百分比：mono + semibold + 右对齐 34 最小宽（FL8 / ui.css .xfer__pct） -->
                                        <TextBlock Text="{Binding Percent}" Style="{StaticResource TextMono}"
                                                   FontSize="{StaticResource Font11}" FontWeight="SemiBold" MinWidth="34"
                                                   TextAlignment="Right" Foreground="{DynamicResource BrushText2}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Style="{StaticResource ProgressBar}" Value="{Binding PercentValue}"
                                                 Margin="0,4,0,0"/>
                                    <!-- meta：大小 · 方向箭头 · 对端（files.html .xfer__meta） -->
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource PadV2}">
                                        <TextBlock Text="{Binding SizeText}" FontSize="{StaticResource Font11}"
                                                   Foreground="{DynamicResource BrushText3}" VerticalAlignment="Center"/>
                                        <TextBlock Text="·" FontSize="{StaticResource Font11}"
                                                   Foreground="{DynamicResource BrushText3}" Margin="8,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <views:IconGlyph Data="{StaticResource IconArrowRight}" Size="11"
                                                         VerticalAlignment="Center"
                                                         TextElement.Foreground="{DynamicResource BrushText3}"/>
                                        <TextBlock Text="{Binding PeerText}" FontSize="{StaticResource Font11}"
                                                   Foreground="{DynamicResource BrushText3}" Margin="4,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- .drop 拖放区：点击或拖入均可发送（FL9） -->
            <Border Style="{StaticResource DropZone}" Margin="0,8,0,0" Cursor="Hand"
                    AllowDrop="True" Drop="OnDropFile" DragOver="OnDragOverFile"
                    MouseLeftButtonUp="OnPickFileClick">
                <StackPanel HorizontalAlignment="Center">
                    <views:IconGlyph Data="{StaticResource IconUpload}" Size="20" HorizontalAlignment="Center" Margin="0,0,0,8"
                                     TextElement.Foreground="{DynamicResource BrushText3}"/>
                    <TextBlock Text="拖入文件，或点击选择" FontWeight="SemiBold" FontSize="{StaticResource Font12}"
                               Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="单文件 1 B – 16 MiB · 文件名不含路径分隔符" FontSize="{StaticResource Font11}"
                               Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </Border>

            <!-- 传输记录（状态徽章按 Err 语义映射，U4） -->
            <TextBlock Text="传输记录" Style="{StaticResource TextCaption}" Margin="0,16,0,4"/>
            <ItemsControl x:Name="Records">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusCtl}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BrushOkSoft}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushWarnSoft}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <views:IconGlyph Size="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <views:IconGlyph.Style>
                                            <Style TargetType="views:IconGlyph">
                                                <Setter Property="Data" Value="{StaticResource IconCheck}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushOkText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconWarn}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushWarnText}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconClose}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushDangerText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </views:IconGlyph.Style>
                                    </views:IconGlyph>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="{StaticResource PadL12}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font12}"
                                               Foreground="{DynamicResource BrushText1}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Display}" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText3}"/>
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource BadgeOk}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushWarnSoft}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StateText}" FontSize="{StaticResource Font11}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushOkText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushWarnText}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushDangerText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 接收设置（.section 折叠区）：fgcore 尚无对应 pref，行按 D4 禁用（FL1） -->
            <Expander Style="{StaticResource SectionExpander}" Margin="0,16,0,0">
                <Expander.Header>
                    <Grid Height="{StaticResource HControl}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <views:IconGlyph Data="{StaticResource IconSettings}" Size="14" VerticalAlignment="Center"
                                             TextElement.Foreground="{DynamicResource BrushText3}"/>
                            <TextBlock Text="接收设置" FontSize="{StaticResource Font12}" FontWeight="Medium"
                                       Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Chevron}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Expander.Header>
                <StackPanel Margin="{StaticResource PadAll12}">

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Opacity="0.5">
                            <TextBlock Text="自动接收来自已配对设备的文件" Style="{StaticResource TextMain}"/>
                            <TextBlock Text="待后续里程碑" Style="{StaticResource TextCaption}"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" IsEnabled="False" Opacity="0.5"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Opacity="0.5">
                            <TextBlock Text="收到前先询问" Style="{StaticResource TextMain}"/>
                            <TextBlock Text="待后续里程碑" Style="{StaticResource TextCaption}"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" IsEnabled="False" Opacity="0.5"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Opacity="0.5">
                            <TextBlock Text="接收目录" Style="{StaticResource TextMain}"/>
                            <TextBlock Text="待后续里程碑" Style="{StaticResource TextCaption}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Opacity="0.5" IsEnabled="False">
                            <TextBox Style="{StaticResource Input}" Width="140" Text="~/Downloads/FlowGrid"/>
                            <Button Style="{StaticResource BtnSmSecondary}" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <views:IconGlyph Data="{StaticResource IconFolder}" Size="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="更改" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Opacity="0.5">
                            <TextBlock Text="退出时清空记录" Style="{StaticResource TextMain}"/>
                            <TextBlock Text="待后续里程碑" Style="{StaticResource TextCaption}"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" IsEnabled="False" Opacity="0.5"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Style="{StaticResource BannerNeutral}">
                        <StackPanel Orientation="Horizontal">
                            <views:IconGlyph Data="{StaticResource IconInfo}" Size="14" VerticalAlignment="Center"
                                             TextElement.Foreground="{DynamicResource BrushText2}"/>
                            <TextBlock FontSize="{StaticResource Font12}" Foreground="{DynamicResource BrushText2}"
                                       Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                                       xml:space="preserve"><Run>单文件 1 B – </Run><Run FontWeight="SemiBold">16 MiB</Run><Run>，分块 249 B；提议 30 秒内未确认即失效，传输中 10 秒无进展判失败；校验通过前不写入目标路径；同一方向同时仅允许一路。</Run></TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- files.html .panel__foot：校验说明（接收目录在上方接收设置区，关闭入口在标题栏） -->
            <TextBlock Text="SHA-256 校验后交付" Style="{StaticResource TextCaption}"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
