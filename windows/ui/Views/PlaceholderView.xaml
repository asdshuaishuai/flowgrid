<UserControl x:Class="FlowGrid.UI.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowGrid.UI.Views">
    <DockPanel Margin="{StaticResource PadContent}">
        <TextBlock DockPanel.Dock="Top" x:Name="TitleHost"
                   Style="{StaticResource TextTitle}" Margin="{StaticResource PadB12}"/>
        <TextBlock DockPanel.Dock="Bottom" Text="此屏将在后续里程碑启用（依赖对端连接 / 传输）"
                   Style="{StaticResource TextCaption}" HorizontalAlignment="Center"
                   Margin="{StaticResource PadT12}"/>
        <views:EmptyState x:Name="Empty" VerticalAlignment="Center"/>
    </DockPanel>
</UserControl>
