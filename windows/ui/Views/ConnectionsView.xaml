<UserControl x:Class="FlowGrid.UI.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowGrid.UI.Views">
    <UserControl.Resources>
        <!-- 本视图装配所需的局部派生样式：一律 BasedOn Themes/Controls.xaml，不自造数值。 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- CN2 设备卡状态着色：在线→accent 描边+浅底，离线→整卡 0.6（ui.css .device 的 active/off 变体） -->
        <Style x:Key="LinkCard" TargetType="Border" BasedOn="{StaticResource DeviceCard}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentLine}"/>
                    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- CN1 延迟芯片四档：tier 由 LinkRow 投影给出（<8 good / <20 warn / 其余 bad，离线 idle） -->
        <Style x:Key="LinkLatChip" TargetType="Border" BasedOn="{StaticResource LatChip}">
            <Setter Property="Background" Value="{DynamicResource BrushIdleSoft}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LatTier}" Value="good">
                    <Setter Property="Background" Value="{DynamicResource BrushOkSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LatTier}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource BrushWarnSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LatTier}" Value="bad">
                    <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LinkLatText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font12}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushIdleText}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LatTier}" Value="good">
                    <Setter Property="Foreground" Value="{DynamicResource BrushOkText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LatTier}" Value="warn">
                    <Setter Property="Foreground" Value="{DynamicResource BrushWarnText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LatTier}" Value="bad">
                    <Setter Property="Foreground" Value="{DynamicResource BrushDangerText}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- CN6 键位映射无框 tile（ui.css .keypair：平时透明，hover 才显 surface-hi） -->
        <Style x:Key="KeyTile" TargetType="Border">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHi}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="{StaticResource PadContent}">
        <!-- 状态行：核心状态 pill + 添加设备（connections.html 第一行） -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusPill" Style="{StaticResource PillIdle}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <!-- G5：状态点套 DotPulse（2s 呼吸）；填充色仍随核心状态在 code-behind 切换 -->
                    <Ellipse x:Name="StatusDot" Style="{StaticResource DotPulse}"
                             Fill="{DynamicResource BrushIdleSolid}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" Text="核心未运行"
                               FontSize="{StaticResource Font11}"
                               Foreground="{DynamicResource BrushIdleText}"/>
                </StackPanel>
            </Border>
            <Button Grid.Column="1" Style="{StaticResource BtnPrimary}"
                    Foreground="{DynamicResource BrushOnAccent}"
                    Click="OnAddDeviceClick">
                <!-- G3：补 plus 图标（ui.css .btn gap 6） -->
                <StackPanel Orientation="Horizontal">
                    <views:Icon Data="{StaticResource IconPlus}" VerticalAlignment="Center"/>
                    <TextBlock Text="添加设备" Margin="{StaticResource PadL6}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer>
            <StackPanel>
                <!-- 链接（连接状态来自 fgcore，windows-link） -->
                <ItemsControl x:Name="Links" Margin="{StaticResource PadT12}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LinkCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- G5：在线设备状态点套 DotPulse -->
                                            <Ellipse Style="{StaticResource DotPulse}"
                                                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                       FontSize="{StaticResource Font13}"
                                                       Foreground="{DynamicResource BrushText1}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- CN2：状态中文语义（windows-link spec：连接中/在线/重连/离线） -->
                                        <TextBlock Text="{Binding StateText, Mode=OneWay}"
                                                   FontSize="{StaticResource Font11}"
                                                   Foreground="{DynamicResource BrushText3}"
                                                   Margin="{StaticResource PadV2}"/>
                                    </StackPanel>
                                    <!-- CN1：延迟四档芯片（离线/idle 显示「—」） -->
                                    <Border Grid.Column="1" Style="{StaticResource LinkLatChip}"
                                            VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource LinkLatText}"
                                                   Text="{Binding LatencyText}"/>
                                    </Border>
                                    <!-- CN5：行内 26×26 ghost 图标钮（按 CoreLink 能力：在线断开 / 离线重连） -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource BtnGhost}" ToolTip="重连"
                                                Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}"
                                                Tag="{Binding}" Click="OnConnectClick">
                                            <views:Icon Data="{StaticResource IconRefresh}"/>
                                        </Button>
                                        <Button Style="{StaticResource BtnGhost}" ToolTip="断开"
                                                Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"
                                                Tag="{Binding}" Click="OnDisconnectClick">
                                            <views:Icon Data="{StaticResource IconClose}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 设备列表（42px 图标 | 名称/元信息 | 地址 pill | 连接） -->
                <ItemsControl x:Name="Devices" Margin="{StaticResource PadT12}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeviceCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource DeviceIconSize}"
                                            Height="{StaticResource DeviceIconSize}"
                                            CornerRadius="{StaticResource RadiusCard}"
                                            Background="{DynamicResource BrushAccentSoft}">
                                        <TextBlock Text="{Binding Initials}" FontWeight="Bold"
                                                   FontSize="{StaticResource Font12}"
                                                   Foreground="{DynamicResource BrushAccentText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="{StaticResource PadL12}"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   FontSize="{StaticResource Font13}"
                                                   Foreground="{DynamicResource BrushText1}"/>
                                        <TextBlock Text="{Binding Meta}" FontSize="{StaticResource Font11}"
                                                   Foreground="{DynamicResource BrushText3}" Margin="{StaticResource PadV2}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource PillIdle}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                        <TextBlock Text="{Binding Addr}" FontSize="{StaticResource Font11}"
                                                   Foreground="{DynamicResource BrushIdleText}"/>
                                    </Border>
                                    <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Content="连接"
                                            VerticalAlignment="Center" Margin="{StaticResource PadL6}"
                                            Tag="{Binding}" Click="OnConnectClick"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <views:EmptyState x:Name="NoDevices" Title="未发现设备"
                                  Description="确认对端已启动 FlowGrid 并在同一网段；发现走 mDNS（_flowgrid._tcp）"
                                  Margin="{StaticResource PadT12}"/>

                <!-- 键位映射折叠区（.mapping 三列网格） -->
                <Expander Style="{StaticResource SectionExpander}" Margin="{StaticResource PadT12}" IsExpanded="True">
                    <Expander.Header>
                        <Grid Height="{StaticResource HControl}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- G3：标题补 keyboard 图标（ui.css .section__head row-3 gap 12） -->
                                <views:Icon Data="{StaticResource IconKeyboard}"
                                            TextElement.Foreground="{DynamicResource BrushText1}"
                                            VerticalAlignment="Center"/>
                                <TextBlock Text="键位映射" FontSize="{StaticResource Font12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"
                                           Margin="{StaticResource PadL12}"/>
                                <!-- CN13：badge 文案改绑 keymap.status 实时数据（code-behind 写入） -->
                                <Border Style="{StaticResource BadgeBorder}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock x:Name="KeymapBadge" Text="— 条生效" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushAccentText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Chevron}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <!-- .mapping 三列无框 tile -->
                        <UniformGrid Columns="3" Margin="12,12,12,4">
                            <Border Style="{StaticResource KeyTile}" Margin="0,0,4,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Style="{StaticResource TextMono}" Text="Ctrl" FontSize="{StaticResource Font11}"
                                                       FontWeight="SemiBold" TextAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="→" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Style="{StaticResource TextMono}" Text="Cmd" FontSize="{StaticResource Font11}"
                                                       FontWeight="SemiBold" TextAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="复制 / 粘贴" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KeyTile}" Margin="4,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Style="{StaticResource TextMono}" Text="Win" FontSize="{StaticResource Font11}"
                                                       FontWeight="SemiBold" TextAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="→" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Style="{StaticResource TextMono}" Text="Alt" FontSize="{StaticResource Font11}"
                                                       FontWeight="SemiBold" TextAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="系统快捷键" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KeyTile}" Margin="4,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Style="{StaticResource TextMono}" Text="Alt" FontSize="{StaticResource Font11}"
                                                       FontWeight="SemiBold" TextAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="→" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Style="{StaticResource TextMono}" Text="Ctrl" FontSize="{StaticResource Font11}"
                                                       FontWeight="SemiBold" TextAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="终端应用" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <!-- CN14：hint 居左、按钮居右（.row between） -->
                        <Grid Margin="12,4,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource TextCaption}" Text="按应用切换映射，游戏内自动停用"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnSmSecondary}" Content="编辑"
                                    Click="OnEditKeymapClick"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 网络延迟折叠区（.chart 12 柱） -->
                <Expander Style="{StaticResource SectionExpander}" Margin="{StaticResource PadT12}" IsExpanded="True">
                    <Expander.Header>
                        <Grid Height="{StaticResource HControl}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- G3：标题补 activity 图标 -->
                                <views:Icon Data="{StaticResource IconActivity}"
                                            TextElement.Foreground="{DynamicResource BrushText1}"
                                            VerticalAlignment="Center"/>
                                <TextBlock Text="网络延迟" FontSize="{StaticResource Font12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"
                                           Margin="{StaticResource PadL12}"/>
                                <Border Style="{StaticResource BadgeOk}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock x:Name="LatBadge" Text="均值 —" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushOkText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Chevron}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <views:LatencyChart x:Name="Chart" Margin="12,8,12,0"/>
                        <!-- 图表横轴：12 柱 × 2s 采样 = 24s 窗口 -->
                        <Grid Margin="12,4,12,12">
                            <TextBlock Text="-24s" FontSize="{StaticResource Font11}"
                                       Foreground="{DynamicResource BrushText3}"/>
                            <TextBlock Text="现在" FontSize="{StaticResource Font11}"
                                       Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Right"/>
                        </Grid>
                        <!-- CN7：页脚 hint 居左 + 详情居右（connections.html:128-131） -->
                        <Grid Margin="12,0,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource TextCaption}" Text="每 2 秒采样一次"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnSmSecondary}" Content="详情"
                                    Click="OnLatencyDetailClick"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
