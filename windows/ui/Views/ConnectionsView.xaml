<UserControl x:Class="FlowGrid.UI.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowGrid.UI.Views">
    <DockPanel Margin="{StaticResource PadContent}">
        <!-- 状态行：核心状态 pill + 添加设备（connections.html 第一行） -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusPill" Style="{StaticResource PillIdle}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="{StaticResource StatusDotSize}"
                             Height="{StaticResource StatusDotSize}" Fill="{DynamicResource BrushIdleSolid}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" Text="核心未运行"
                               FontSize="{StaticResource Font11}"
                               Foreground="{DynamicResource BrushIdleText}"/>
                </StackPanel>
            </Border>
            <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="添加设备"
                    Click="OnAddDeviceClick"/>
        </Grid>

        <ScrollViewer>
            <StackPanel>
                <!-- 链接（连接状态来自 fgcore，windows-link） -->
                <ItemsControl x:Name="Links" Margin="{StaticResource PadT12}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeviceCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                   FontSize="{StaticResource Font13}"
                                                   Foreground="{DynamicResource BrushText1}"/>
                                        <TextBlock FontSize="{StaticResource Font11}"
                                                   Foreground="{DynamicResource BrushText3}"
                                                   Margin="{StaticResource PadV2}">
                                            <Run Text="{Binding State, Mode=OneWay}"/>
                                            <Run Text="{Binding LatencyText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource BtnSecondary}"
                                            Content="断开" VerticalAlignment="Center"
                                            Tag="{Binding Instance}" Click="OnDisconnectClick"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 设备列表（42px 图标 | 名称/元信息 | 地址 pill | 连接） -->
                <ItemsControl x:Name="Devices" Margin="{StaticResource PadT12}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeviceCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="{StaticResource DeviceIconSize}"
                                            Height="{StaticResource DeviceIconSize}"
                                            CornerRadius="{StaticResource RadiusCard}"
                                            Background="{DynamicResource BrushAccentSoft}">
                                        <TextBlock Text="{Binding Initials}" FontWeight="Bold"
                                                   FontSize="{StaticResource Font12}"
                                                   Foreground="{DynamicResource BrushAccentText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="{StaticResource PadL12}"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   FontSize="{StaticResource Font13}"
                                                   Foreground="{DynamicResource BrushText1}"/>
                                        <TextBlock Text="{Binding Meta}" FontSize="{StaticResource Font11}"
                                                   Foreground="{DynamicResource BrushText3}" Margin="{StaticResource PadV2}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource PillIdle}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                        <TextBlock Text="{Binding Addr}" FontSize="{StaticResource Font11}"
                                                   Foreground="{DynamicResource BrushIdleText}"/>
                                    </Border>
                                    <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Content="连接"
                                            VerticalAlignment="Center" Margin="{StaticResource PadL6}"
                                            Tag="{Binding Instance}" Click="OnConnectClick"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <views:EmptyState x:Name="NoDevices" Title="未发现设备"
                                  Description="确认对端已启动 FlowGrid 并在同一网段；发现走 mDNS（_flowgrid._tcp）"
                                  Margin="{StaticResource PadT12}"/>

                <!-- 键位映射折叠区（.mapping 三列网格） -->
                <Expander Style="{StaticResource SectionExpander}" Margin="{StaticResource PadT16}" IsExpanded="True">
                    <Expander.Header>
                        <Grid Height="{StaticResource HControl}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="键位映射" FontSize="{StaticResource Font12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource BadgeBorder}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="3 条生效" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushAccentText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="KeymapChev" Text="▾" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <!-- .mapping 三列网格 -->
                        <UniformGrid Columns="3" Margin="12,12,12,4">
                            <Border Style="{StaticResource DeviceCard}" Margin="0,0,4,0" Padding="8,8,8,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Text="Ctrl" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="→" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Text="Cmd" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="复制 / 粘贴" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DeviceCard}" Margin="4,0,4,0" Padding="8,8,8,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Text="Win" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="→" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Text="Alt" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="系统快捷键" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DeviceCard}" Margin="8,0,0,0" Padding="8,8,8,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Text="Alt" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="→" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,5,0">
                                            <TextBlock Text="Ctrl" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="终端应用" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,4,12,12">
                            <TextBlock Text="按应用切换映射，游戏内自动停用" FontSize="{StaticResource Font11}"
                                       Foreground="{DynamicResource BrushText3}" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Button Style="{StaticResource BtnSmSecondary}" Content="编辑" Click="OnEditKeymapClick"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- 网络延迟折叠区（.chart 12 柱） -->
                <Expander Style="{StaticResource SectionExpander}" Margin="0,8,0,0" IsExpanded="True">
                    <Expander.Header>
                        <Grid Height="{StaticResource HControl}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="网络延迟" FontSize="{StaticResource Font12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource BadgeOk}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock x:Name="LatBadge" Text="均值 —" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushOkText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="▾" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <views:LatencyChart x:Name="Chart" Margin="12,8,12,0"/>
                        <Grid Margin="12,4,12,12">
                            <TextBlock Text="-60s" FontSize="{StaticResource Font11}"
                                       Foreground="{DynamicResource BrushText3}"/>
                            <TextBlock Text="现在" FontSize="{StaticResource Font11}"
                                       Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
