<UserControl x:Class="FlowGrid.UI.Views.KeymapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FlowGrid.UI.Views">
    <!-- keymap.html：头部统计 + 全局键帽映射 + 应用覆盖/高级（D4）+ 页脚 -->
    <DockPanel Margin="{StaticResource PadContent}">

        <!-- 页脚：左匹配顺序说明 / 右恢复默认（D4） -->
        <Grid DockPanel.Dock="Bottom" Margin="{StaticResource PadT12}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <views:Icon Data="{StaticResource IconInfo}" Size="12"
                            TextElement.Foreground="{DynamicResource BrushText3}"
                            VerticalAlignment="Center"/>
                <TextBlock Text="规则按从上到下顺序匹配" Style="{StaticResource TextCaption}"
                           Margin="{StaticResource PadL6}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource BtnSmSecondary}" Content="恢复默认" IsEnabled="False"
                    ToolTip="待后续里程碑" HorizontalAlignment="Right"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 头部统计：生效规则数（实时）+ 新增规则（D4） -->
                <Grid Margin="{StaticResource PadB12}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource BadgeBorder}" VerticalAlignment="Center">
                            <TextBlock x:Name="RulesBadge" Text="— 条生效" FontSize="{StaticResource Font11}"
                                       Foreground="{DynamicResource BrushAccentText}"/>
                        </Border>
                        <TextBlock Text="按应用自动切换" Style="{StaticResource TextCaption}"
                                   Margin="{StaticResource PadL6}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BtnSmSecondary}" Content="新增规则"
                            IsEnabled="False" ToolTip="待后续里程碑"/>
                </Grid>

                <views:EmptyState x:Name="Empty" Title="自定义规则未加载"
                                  Description="把 keymap.yaml 放到 %APPDATA%\FlowGrid\ 后重启 fgcore；无规则时仅做下面的修饰键语义映射"
                                  Margin="{StaticResource PadB12}"/>

                <!-- 全局映射（§6.3 恒启用，真实数据） -->
                <Expander Style="{StaticResource SectionExpander}" IsExpanded="True" Margin="{StaticResource PadB12}">
                    <Expander.Header>
                        <Grid Height="{StaticResource HControl}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <views:Icon Data="{StaticResource IconKeyboard}" Size="12"
                                            TextElement.Foreground="{DynamicResource BrushText3}"
                                            VerticalAlignment="Center"/>
                                <TextBlock Text="全局" FontSize="{StaticResource Font12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"
                                           Margin="{StaticResource PadL6}"/>
                                <Border Style="{StaticResource BadgeBorder}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock x:Name="GlobalBadge" Text="—" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushAccentText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Chevron}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="12">
                        <!-- Ctrl → Cmd (macOS) -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Ctrl" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                           VerticalAlignment="Center" Margin="{StaticResource PadL6}"/>
                                <Border Style="{StaticResource KeyCap}" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="Cmd" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Windows → macOS" Style="{StaticResource TextCaption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Win → Ctrl (macOS) -->
                        <Grid Margin="{StaticResource PadT12}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Win" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                           VerticalAlignment="Center" Margin="{StaticResource PadL6}"/>
                                <Border Style="{StaticResource KeyCap}" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="Ctrl" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Windows → macOS" Style="{StaticResource TextCaption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Alt → Option (macOS) -->
                        <Grid Margin="{StaticResource PadT12}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Alt" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                           VerticalAlignment="Center" Margin="{StaticResource PadL6}"/>
                                <Border Style="{StaticResource KeyCap}" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="Option" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Windows → macOS" Style="{StaticResource TextCaption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Ctrl / Alt / Win → 不变 (Linux) -->
                        <Grid Margin="{StaticResource PadT12}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Ctrl" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource KeyCap}" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="Alt" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource KeyCap}" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="Win" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                </Border>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushText3}" FontSize="{StaticResource Font11}"
                                           VerticalAlignment="Center" Margin="{StaticResource PadL6}"/>
                                <Border Style="{StaticResource KeyCap}" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="不变" FontSize="{StaticResource Font11}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText1}" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Windows → Linux" Style="{StaticResource TextCaption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="RulesPath" Text="规则文件未加载" Style="{StaticResource TextCaption}"
                                   Margin="{StaticResource PadT12}"/>
                    </StackPanel>
                </Expander>

                <!-- 应用覆盖（后端无规则引擎，整组 D4） -->
                <Expander Style="{StaticResource SectionExpander}" IsExpanded="True" Margin="{StaticResource PadB12}">
                    <Expander.Header>
                        <Grid Height="{StaticResource HControl}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <views:Icon Data="{StaticResource IconMonitor}" Size="12"
                                            TextElement.Foreground="{DynamicResource BrushText3}"
                                            VerticalAlignment="Center"/>
                                <TextBlock Text="应用覆盖" FontSize="{StaticResource Font12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"
                                           Margin="{StaticResource PadL6}"/>
                                <Border Style="{StaticResource BadgeNeutral}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="2 条" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText2}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Chevron}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="12" Opacity="0.5" IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Visual Studio Code" Style="{StaticResource TextMain}"/>
                                <TextBlock Text="Ctrl 直通，禁用 ⌘ 转换" Style="{StaticResource TextCaption}" Margin="{StaticResource PadV2}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource BtnGhost}" Margin="{StaticResource PadL6}" VerticalAlignment="Center">
                                    <views:Icon Data="{StaticResource IconEdit}" Size="12"
                                                TextElement.Foreground="{DynamicResource BrushText3}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="{StaticResource PadT12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="游戏（全屏时）" Style="{StaticResource TextMain}"/>
                                <TextBlock Text="停用全部映射，避免误触" Style="{StaticResource TextCaption}" Margin="{StaticResource PadV2}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource BtnGhost}" Margin="{StaticResource PadL6}" VerticalAlignment="Center">
                                    <views:Icon Data="{StaticResource IconEdit}" Size="12"
                                                TextElement.Foreground="{DynamicResource BrushText3}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="待后续里程碑" Style="{StaticResource TextCaption}" Margin="{StaticResource PadT12}"/>
                    </StackPanel>
                </Expander>

                <!-- 高级（默认收起，两个 D4 开关） -->
                <Expander Style="{StaticResource SectionExpander}" IsExpanded="False" Margin="{StaticResource PadB12}">
                    <Expander.Header>
                        <Grid Height="{StaticResource HControl}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <views:Icon Data="{StaticResource IconSettings}" Size="12"
                                            TextElement.Foreground="{DynamicResource BrushText3}"
                                            VerticalAlignment="Center"/>
                                <TextBlock Text="高级" FontSize="{StaticResource Font12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center"
                                           Margin="{StaticResource PadL6}"/>
                                <Border Style="{StaticResource BadgeNeutral}" VerticalAlignment="Center" Margin="{StaticResource PadL6}">
                                    <TextBlock Text="2 项" FontSize="{StaticResource Font11}"
                                               Foreground="{DynamicResource BrushText2}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Chevron}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="12" Opacity="0.5" IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="按键重复率跟随目标端" Style="{StaticResource TextMain}"/>
                                <TextBlock Text="使用被控设备的系统重复设置" Style="{StaticResource TextCaption}" Margin="{StaticResource PadV2}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="{StaticResource PadT12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="发送原始扫描码" Style="{StaticResource TextMain}"/>
                                <TextBlock Text="游戏与远程桌面场景更精确" Style="{StaticResource TextCaption}" Margin="{StaticResource PadV2}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="待后续里程碑" Style="{StaticResource TextCaption}" Margin="{StaticResource PadT12}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
