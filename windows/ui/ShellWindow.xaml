<Window x:Class="FlowGrid.UI.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FlowGrid" Width="{StaticResource WPanel}" SizeToContent="Height"
        MaxHeight="620" MinWidth="{StaticResource WPanel}" MaxWidth="{StaticResource WPanel}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        AllowsTransparency="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource RowTitlebarNum}"
                      ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- .panel：radius surface / border line-2 / surface 底 / 顶部 1px 内高光 -->
    <Border x:Name="RootBorder" Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushLine2}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusSurface}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="42" ShadowDepth="18" Opacity="0.14"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource RowTitlebar}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- .titlebar：surface-2 底 + hairline 底边 + 左标题/右元素/关闭 -->
            <Grid Grid.Row="0" Background="{DynamicResource BrushSurface2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BrushHairline}"/>
                <ContentControl x:Name="TitleRightHost" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,42,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <TextBlock x:Name="ScreenTitle" Text="设备与连接" FontWeight="SemiBold"
                           FontSize="{StaticResource Font12}"
                           Foreground="{DynamicResource BrushText1}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Style="{StaticResource TitlebarClose}" Content="✕"
                        VerticalAlignment="Top" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClick"/>
            </Grid>

            <!-- .content：各屏自带 14 边距，滚动容器 -->
            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="ContentHost"/>
            </ScrollViewer>

            <!-- Toast（.toast：底部居中，300ms 淡入，1.8s 自动消失） -->
            <Border x:Name="Toast" Grid.Row="1" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,20" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource BrushToastBg}"
                    CornerRadius="{StaticResource RadiusCard}" Padding="16,8,16,8">
                <TextBlock x:Name="ToastText" FontWeight="SemiBold" FontSize="{StaticResource Font12}"
                           Foreground="{DynamicResource BrushToastFg}"/>
            </Border>
        </Grid>
    </Border>
</Window>
