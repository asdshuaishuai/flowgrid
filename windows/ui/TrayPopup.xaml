<Window x:Class="FlowGrid.UI.TrayPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FlowGrid.UI.Views"
        Title="FlowGrid" Width="360" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        AllowsTransparency="True" ShowActivated="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <!-- tray.html：300px 浮板（状态头/当前设备/快速切换/入口/快捷开关/退出） -->
    <Border x:Name="RootBorder" Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushLine2}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusSurface}" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="16" Opacity="0.18"/>
        </Border.Effect>
        <StackPanel Margin="{StaticResource PadContent}">

            <!-- 状态头：标题 + 状态 pill + 设置/关闭 -->
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FlowGrid" FontWeight="SemiBold" FontSize="{StaticResource Font13}"
                               Foreground="{DynamicResource BrushText1}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="HeadPill" Style="{StaticResource PillOk}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}"
                                     Fill="{DynamicResource BrushOkSolid}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HeadPillText" Text="—" FontSize="{StaticResource Font11}"
                                       Foreground="{DynamicResource BrushOkText}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsBtn" Width="20" Height="20"
                            Foreground="{DynamicResource BrushText3}" Background="Transparent"
                            Cursor="Hand" Click="OnOpenSettingsClick" Margin="0,0,4,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurfaceHi}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushText1}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <views:IconGlyph Data="{StaticResource IconSettings}" Size="12"/>
                    </Button>
                    <Button Content="✕" Width="20" Height="20" FontSize="{StaticResource Font11}"
                            Foreground="{DynamicResource BrushText3}" Background="Transparent"
                            Cursor="Hand" Click="OnCloseClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurfaceHi}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushText1}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 当前设备 -->
            <TextBlock Text="当前设备" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
            <Border Style="{StaticResource DeviceCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="{StaticResource DeviceIconSize}" Height="{StaticResource DeviceIconSize}"
                            CornerRadius="21" Background="{DynamicResource BrushSurface3}">
                        <TextBlock x:Name="SelfInitials" Text="FG" FontWeight="SemiBold"
                                   FontSize="{StaticResource Font13}"
                                   Foreground="{DynamicResource BrushText2}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="{StaticResource PadL12}" VerticalAlignment="Center">
                        <TextBlock x:Name="SelfName" Text="本机" FontWeight="Medium"
                                   FontSize="{StaticResource Font12}"
                                   Foreground="{DynamicResource BrushText1}"/>
                        <TextBlock x:Name="SelfHint" Text="本机键鼠直通" FontSize="{StaticResource Font11}"
                                   Foreground="{DynamicResource BrushText3}" Margin="{StaticResource PadV2}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource BadgeBorder}" VerticalAlignment="Center">
                        <TextBlock Text="本机" FontSize="{StaticResource Font11}"
                                   Foreground="{DynamicResource BrushText3}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 快速切换 -->
            <TextBlock Text="快速切换（Ctrl+Alt+数字）" Style="{StaticResource TextCaption}" Margin="0,10,0,4"/>
            <StackPanel x:Name="SwitchHost"/>

            <Border Height="1" Background="{DynamicResource BrushHairline}" Margin="0,10,0,0"/>

            <!-- 连接 -->
            <TextBlock Text="连接" Style="{StaticResource TextCaption}" Margin="0,10,0,4"/>
            <StackPanel x:Name="LinkRows"/>

            <Border Height="1" Background="{DynamicResource BrushHairline}" Margin="0,10,0,0"/>

            <!-- 数据与同步 -->
            <TextBlock Text="数据与同步" Style="{StaticResource TextCaption}" Margin="0,10,0,4"/>
            <StackPanel x:Name="DataRows"/>

            <Border Height="1" Background="{DynamicResource BrushHairline}" Margin="0,10,0,0"/>

            <!-- 快捷开关 -->
            <TextBlock Text="快捷开关" Style="{StaticResource TextCaption}" Margin="0,10,0,4"/>
            <Grid Height="24">
                <TextBlock Text="剪贴板同步" Style="{StaticResource TextMain}" VerticalAlignment="Center"/>
                <ToggleButton x:Name="ClipSyncToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                              Checked="OnClipSyncToggle" Unchecked="OnClipSyncToggle"/>
            </Grid>
            <Grid Height="24" Opacity="0.5">
                <TextBlock Text="鼠标平滑" Style="{StaticResource TextMain}" VerticalAlignment="Center"/>
                <TextBlock Text="待后续里程碑" Style="{StaticResource TextCaption}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid Height="24" Opacity="0.5">
                <TextBlock Text="自动路由" Style="{StaticResource TextMain}" VerticalAlignment="Center"/>
                <TextBlock Text="待后续里程碑" Style="{StaticResource TextCaption}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Border Height="1" Background="{DynamicResource BrushHairline}" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
